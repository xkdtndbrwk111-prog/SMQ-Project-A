=window||(ev.code!=='Enter'&&ev.code!=='Space'))return;","   ev.preventDefault();","   ev.stopImmediatePropagation();","   if(ev.repeat)return;","   window.parent.postMessage({kind:'HOJA_TUT_DIALOG_NEXT',event:pending},'*');"," },true);"," window.addEventListener('message',e=>{","   if(e.data?.kind==='HOJA_TUT_RESUME'&&pending===e.data.event){","     pending=null;window.__HOJA_TUT_PENDING_EVENT=null;","     const scene=window.HOJA_PHASER_APP?.scene?.();","     if(e.data.event!=='quiz'&&scene?.scene?.isPaused?.())scene.scene.resume();","     window.focus();","   }"," });"," const originalShow=HojaScene.prototype.showQuiz;"," HojaScene.prototype.showQuiz=function(...args){","   const q=originalShow.apply(this,args);","   window.HOJA_TUT_NATIVE_SIGNAL?.('quiz');","   return q;"," };"," window.HOJA_TUTORIAL_DIAG=()=>({engine:typeof HojaScene,booted:!!window.HOJA_PHASER_APP,stage:STAGE?.theme,score:RUN.score,answered:RUN.quizAnswered,flags:{...FLAGS},pending});"," // Passive observation only. Never replace HojaScene.update, movement or collisions."," setInterval(()=>{","   const s=window.HOJA_PHASER_APP?.scene?.();","   if(!s?.playerBody?.body||s.dying||pending)return;","   if(!FLAGS.init){s.scene.pause();window.HOJA_TUT_NATIVE_SIGNAL('init');return;}","   if(s.scene.isPaused()||s.quizActive)return;","   const x=s.playerBody.x/TILE;","   const fire=(k)=>{s.scene.pause();window.HOJA_TUT_NATIVE_SIGNAL(k);};","   if(!FLAGS.jump&&x>=12){fire('jump');return;}","   if(!FLAGS.slime&&x>=31){fire('slime');return;}","   const slime=s.enemies?.find(e=>e.type==='JUMPY');","   if(!FLAGS.ghost&&x>=49){fire('ghost');return;}","   if(!FLAGS.balloon&&x>=73){fire('balloon');return;}","   if(FLAGS.quiz&&!FLAGS.quizResult&&!s.quizActive&&s.quizAnswered>0){","     FLAGS.quizResult=true;fire(s.correctQuizCount>0?'quizCorrect':'quizWrong');return;","   }","   if(FLAGS.quizResult&&!FLAGS.afterQuiz){fire('afterQuiz');return;}","   if(!FLAGS.pipe&&x>=95){fire('pipe');return;}"," },110);","})();",